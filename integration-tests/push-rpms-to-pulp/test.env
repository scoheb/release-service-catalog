uuid=${uuid:-"$(openssl rand -hex 4)"}
# make sure uuid is 8 chars long
export uuid="${uuid:0:8}"

export originating_tool="push-rpms-to-pulp-e2e-test"

# Interactive mode: pause on failure and allow retries with the same snapshot
# Enable with: ./run-test.sh push-rpms-to-pulp -i
# Or set INTERACTIVE_MODE=true as env var
export INTERACTIVE_MODE="${INTERACTIVE_MODE:-false}"

# Namespaces
export tenant_namespace=dev-release-team-tenant
export managed_namespace=managed-release-team-tenant

export application_name=push-rpms-app-${uuid}
export component_type=push-rpms-to-pulp
export component_name=${component_type}-${uuid}
export component_branch=${component_name}
## do not change this. it is a known branch created by Konflux
export appstudio_component_branch="appstudio-${component_name}"

export component_github_org=hacbs-release-tests
export component_base_branch=push-rpms-to-pulp-base
export component_repo_name=${component_github_org}/${component_name}
export component_base_repo_name=${component_github_org}/e2e-base
export component_git_url=https://github.com/$component_repo_name

export tenant_collector_sa_name=push-rpms-to-pulp-rp-${uuid}
export release_plan_name=push-rpms-to-pulp-rp-${uuid}

export managed_sa_name=push-rpms-to-pulp-sa-${uuid}
export release_plan_admission_name=push-rpms-to-pulp-rpa-${uuid}

# RPM Signing configuration
# Set SIGNING_ENABLED=true to test the signing flow (uses unsignedDomain -> publicDomain)
# When false (default), uses legacy flow (direct push to domain)
export SIGNING_ENABLED="${SIGNING_ENABLED:-false}"

if [[ "${SIGNING_ENABLED}" == "true" ]]; then
  echo "ℹ️ Signing flow ENABLED - using unsignedDomain/publicDomain configuration"
  # Indentation matters - this gets substituted into the RPA YAML (under pulp:)
  export PULP_SIGNING_CONFIG='      unsignedDomain: konflux-release-integration-tests-unsigned
      publicDomain: konflux-release-integration-tests
    signing:
      keyId: test-signing-key'
else
  echo "ℹ️ Signing flow DISABLED - using legacy domain configuration"
  # Use a YAML comment to avoid empty line parsing errors
  export PULP_SIGNING_CONFIG='      # signing: disabled'
fi
